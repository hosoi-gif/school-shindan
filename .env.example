# サーバーポート（Railwayでは自動設定されるPORTが優先されます）
PORT=3101

# 最上位管理画面（/admin, /admin/venues）の共有パスワード
# 未設定の場合はローカル開発用に "changeme" が使われます。本番では必ず変更してください。
ADMIN_PASSWORD=changeme

# 共通設定・会場データの保存先ディレクトリ（任意）
# 未設定ならdata。Railwayなど再デプロイでファイルシステムが
# 初期化される環境では、永続ボリュームのマウント先をここに指定してください。
# 例: DATA_DIR=/data
DATA_DIR=
